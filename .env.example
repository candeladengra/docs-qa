# This is a root .env.example file
# Copy to .env and adjust values as needed

# AI Provider Configuration
# Options: 'ollama' (free, local) or 'gemini' (requires API key)
AI_PROVIDER=ollama

# Ollama Configuration (when AI_PROVIDER=ollama)
# Make sure Ollama is installed and running on your host machine
# Install: https://ollama.ai
# Pull models: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gemini Configuration (when AI_PROVIDER=gemini)
# Get a free API key: https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=your-api-key-here

# Database
POSTGRES_DB=docsqa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Django
DJANGO_SECRET_KEY=dev-secret-key-change-in-production
DJANGO_DEBUG=True
