# Copy this file to .env and fill in real values
# DO NOT commit .env to git

# Database
POSTGRES_DB=docsqa
POSTGRES_USER=docsqa_user
POSTGRES_PASSWORD=CHANGE_ME_TO_SECURE_PASSWORD

# Django
DJANGO_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY
DJANGO_DEBUG=True

# Redis
REDIS_PORT=6379

# AI Provider: 'ollama' or 'gemini'
AI_PROVIDER=ollama

# Ollama settings (for local, free inference)
# Make sure Ollama is installed and running on your host machine
# Install: https://ollama.ai
# Pull models: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# Gemini settings (alternative, requires API key)
# Get a free API key: https://makersuite.google.com/app/apikey
# AI_PROVIDER=gemini
# GEMINI_API_KEY=your-api-key-here
